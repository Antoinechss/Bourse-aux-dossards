# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# local | prod
APP_ENV=local

# SQLite en local, URL Postgres Neon en prod
DATABASE_URL=sqlite:///relais.db

# PayPal : sandbox uniquement
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Identifiant du webhook, donné par PayPal quand on déclare l'adresse https://…/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Comptes sandbox des données de démo (destinataires des Payouts)
DEMO_ORGANIZER_EMAIL=
# Emails des coureurs, séparés par des virgules
DEMO_RUNNER_EMAILS=

# API Anthropic (Claude)
ANTHROPIC_API_KEY=
